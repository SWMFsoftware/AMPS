RUNDIR = ${PTDIR}/run
SCRIPTDIR = ${PTDIR}/share/Scripts
SHAREDIR = ${PTDIR}/share/Library/src

COMMONDIR = ${MYDIR}/share
INCLDIR   = ${COMMONDIR}/include
BUILDDIR  = ${COMMONDIR}/build
LIBDIR    = ${COMMONDIR}/lib

SOURCES=src
WSD=build

Lib=  -lm
SPICE=nospice

ExternalModules=models/exosphere

INTERFACE=off

include ${PTDIR}/Makefile.test
# Tier=long tests of MakefileTest/Table (utility/TestScripts/table_parser.cpp); the nightly never runs them
-include ${PTDIR}/Makefile.test.long

