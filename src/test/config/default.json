{
  "schema_version": 1,
  "paths": {
    "output_root": "test_output/core-tests",
    "temporary_root": "",
    "data_root": "",
    "spice_path": "",
    "spice_kernels": ""
  },
  "tools": {
    "python": ["python3"],
    "cxx": ["c++"],
    "mpi_cxx": ["mpicxx"],
    "make": ["make"],
    "mpiexec": ["mpiexec"]
  },
  "execution": {
    "build_jobs": 16,
    "mpi_ranks": 1,
    "mpi_rank_flag": "-n",
    "default_timeout_seconds": 300,
    "keep_work": "failures"
  },
  "capabilities": {
    "moon-spice": {
      "available": false,
      "policy": "optional"
    },
    "enceladus-e3": {
      "available": false,
      "policy": "optional"
    }
  }
}
