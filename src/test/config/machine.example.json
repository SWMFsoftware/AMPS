{
  "schema_version": 1,
  "paths": {
    "output_root": "${SCRATCH}/amps-test-results",
    "temporary_root": "${SCRATCH}/amps-test-work",
    "data_root": "${SCRATCH}/amps-reference-data",
    "spice_path": "/site/SPICE/cspice",
    "spice_kernels": "/site/SPICE/Kernels"
  },
  "tools": {
    "python": ["python3"],
    "cxx": ["g++"],
    "mpi_cxx": ["mpicxx"],
    "make": ["gmake"],
    "mpiexec": ["srun"],
    "fortran": ["gfortran"],
    "clang_cxx": ["clang++"],
    "valgrind": ["valgrind"],
    "nvcc": ["nvcc"],
    "openmpi_cxx": ["mpicxx.openmpi"],
    "openmpi_exec": ["mpiexec.openmpi"],
    "mpich_cxx": ["mpicxx.mpich"],
    "mpich_exec": ["mpiexec.mpich"]
  },
  "execution": {
    "build_jobs": 32,
    "mpi_ranks": 4,
    "mpi_rank_flag": "-n",
    "default_timeout_seconds": 900,
    "keep_work": "failures"
  },
  "capabilities": {
    "moon-spice": {
      "available": true,
      "policy": "optional"
    },
    "enceladus-e3": {
      "available": false,
      "policy": "optional"
    }
  }
}
