# Generated analytic-verification fixture for Stage-0 parser tests.
# It is test evidence, not an event configuration or a source of defaults.

[run]
schema_version = 5
intent = analytic-verification
transport = ballistic-verification
transport_frame = inertial
start_time_s = 0
end_time_s = 86400
maximum_steps = 0
campaign_seed_u64 = 731993
random_stream_layout = keyed-v1

[domain]
solar_radius_m = 6.957e8
qualified_source_inner_radius_m = 7.02657e8
outer_radius_m = 2.0871e10
inner_boundary = solar-sphere-absorb
outer_boundary = escape
outer_boundary_geometry = sun-centered-sphere
coordinate_frame = fixture
epoch_utc = fixture

[solar_rotation]
model = rigid
rigid_input_rotation_rate_rad_per_s = 2.86532908457e-6
input_rate_convention = sidereal
synodic_conversion_ephemeris_file = none
differential_rotation_coefficients_file = none

[pfss]
lower_boundary = analytic-harmonics
outer_boundary_radius_m = 1.73925e9
maximum_degree = 8
harmonic_normalization = orthonormal-complex
coefficients_file = analytic-dipole.coeff
flux_balance = reject
spectral_filter = none
apodization_degree = 0
input_grid = coefficient-file
quadrature = coefficient-file
cache_radial_points = 1
cache_colatitude_points = 1
cache_longitude_points = 1
cache_interpolation_order = 1

[current_sheet]
model = finite-shell-schatten
interface_coupling = direct-pfss-scs
interface_radius_m = 1.53054e9
outer_radial_radius_m = 1.73925e9
sector_mapping = field-line-traced
maximum_degree = 8
unsigned_boundary_fit = nonnegative-constrained
fit_quadrature = cell-area
fit_angular_oversampling = 0
maximum_normal_field_error_tesla = 0
maximum_unsigned_flux_relative_error = 0
maximum_negative_area_fraction = 0
radialization_gate = diagnostic-only
maximum_outer_zonal_nonmonopole_power_fraction = 0
latitude_diagnostic_radii_m = 6.957e9,1.3914e10
latitude_minimum_unmasked_longitude_fraction = 0
maximum_unsigned_radial_flux_rms_fraction = 0
maximum_unsigned_radial_flux_p95_to_p05_ratio = 0
interface_particle_rule = not-applicable
resolved_transition_width_m = 0
resolved_transition_profile = none
transition_vector_potential = none
transition_vector_potential_gauge = none
transition_hcs_policy = not-applicable
transition_hcs_clearance_m = 0
maximum_transition_normal_trace_jump_fraction = 0
transition_minimum_field_tesla = 0
transition_jump_support_fraction = 0
transition_clearance_convergence_asset_file = none
maximum_verified_kink_angle_rad = 0
weak_field_policy = not-applicable
weak_field_reference_tesla = 0
weak_field_relative_threshold = 0

[closed_field_plasma]
model = isothermal-hydrostatic
reference_radius_m = 6.957e8
base_state = species-density-temperature
base_proton_number_density_m3 = 1e14
base_proton_temperature_k = 1.5e6
base_electron_temperature_k = 1.5e6
base_alpha_temperature_k = 0
closed_polytropic_index = 0
base_normalization = prescribed
base_normalization_asset_file = none
composition_source = solar-wind
velocity_frame = corotating
force_model = gravity-plus-centrifugal
maximum_centrifugal_to_gravity_ratio = 0.1

[open_closed_interface]
representation = sharp-one-sided
policy = diagnostic-kinematic
state_origin = analytic-composite
transition_width_m = 0
thickness_ensemble_m = none
interface_velocity_model = corotating-topology-surface
interface_velocity_asset_file = none
uncertainty_asset_file = none
maximum_absolute_traction_jump_pa = 0
maximum_relative_traction_jump = 0
traction_jump_quantile = 0
maximum_absolute_mass_flux_jump_kg_per_m2_per_s = 0
maximum_relative_mass_flux_jump = 0
mass_flux_jump_quantile = 0
maximum_absolute_volume_momentum_residual_n_per_m3 = 0
maximum_relative_volume_momentum_residual = 0
volume_residual_quantile = 0
minimum_convergence_levels = fixture
maximum_residual_refinement_change = fixture
null_neighborhood_field_threshold_tesla = 1
maximum_absolute_normal_field_tesla = 1
maximum_relative_normal_field = fixture
maximum_absolute_relative_normal_velocity_m_per_s = 1
maximum_relative_normal_velocity_fast_mach = fixture

[solar_wind]
model = flux-tube-polytropic
scientific_role = analytic-verification
base_reference_radius_m = 6.957e8
energy_closure = polytropic
polytropic_index = 1.05
temperature_model = uniform
uniform_base_temperature_k = 1.5e6
target_speed_definition = none
target_speed_relation = none
target_speed_coefficients_file = none
target_speed_radius_m = 0
kinematic_profile_manifest_file = none
kinematic_profile_manifest_schema = none
kinematic_interpolation = none
inner_outer_blend_inner_radius_m = 0
inner_outer_blend_outer_radius_m = 0
mass_flux_model = uniform-base-density
mass_flux_coefficients_file = none
mass_flux_data_use_role = none
base_number_density_m3 = 0
mass_per_magnetic_flux_kg_per_s_per_wb = 0
outer_mass_flux_density_kg_per_m2_per_s = 0
mass_flux_reference_radius_m = 0
composition = proton-electron
alpha_to_proton_ratio = 0
composition_asset_file = none
composition_uncertainty_model = none
composition_covariance_or_ensemble_file = none
electron_density_conversion = quasineutral-composition-and-charge-state
momentum_residual_policy = transonic-solve
momentum_residual_acceleration_floor_m_per_s2 = 1e-12
maximum_normalized_momentum_residual = 1
maximum_absolute_momentum_residual_m_per_s2 = 100
d7_qualification_asset_file = none
d7_qualification_data_use_role = none
d7_withheld_validation_asset_file = none
d7_withheld_validation_data_use_role = none
d7_comparison_radii_m = none
d7_maximum_relative_density_mismatch = 0
d7_maximum_relative_speed_mismatch = 0
d7_maximum_relative_mass_flux_mismatch = 0
d7_maximum_overlap_absolute_log_density_mismatch = 0
d7_maximum_overlap_covariance_normalized_mismatch = 0
required_consumer_coverage_policy = fail-required-event-support
d7_minimum_open_magnetic_flux_coverage_fraction = 0
d7_minimum_open_area_coverage_fraction = 0
d7_minimum_source_flux_coverage_fraction = 0
d7_minimum_observer_exposure_coverage_fraction = 0
d7_minimum_export_support_coverage_fraction = 0

[plasma_eos]
model = ideal-single-fluid
adiabatic_index = 1.6666666666666667
electron_mass_in_density = neglect-recorded
near_parallel_threshold_rad = 1
