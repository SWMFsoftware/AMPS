# BG3D-1 typed input record; BG3D-4/5 own map implementation/qualification.
profile=vector-potential-material-map-v1
vector_potential_model=axisymmetric-polynomial-a-v1
sheath_admission_start_s=0
# This global limiting startup has coincident shock/contact and exactly zero
# initial sheath volume. It is not reapplied when a local patch becomes fast.
sheath_startup_model=zero-volume-global-start-v1
# The material rear boundary is the globally oldest admitted cohort. The
# separate fraction below remains BG3D-5 ejecta-reference geometry only.
sheath_contact_model=oldest-global-cohort-v1
# Each finite admission cell owns a regular curved cohort prism; its reference
# metric includes both surface-area and downstream crossing-speed factors.
sheath_reference_map_model=shock-fed-cohort-prism-v1
contact_apex_fraction=0.99
ejecta_reference_density_kg_m3=1e-13
ejecta_reference_pressure_pa=1e-3
axial_flux_wb=1e13
poloidal_flux_wb=5e12
minimum_jacobian=1e-6
maximum_integrated_force_ratio=2
maximum_local_force_ratio_p99=5
maximum_force_work_ratio=2
added_heating=zero
# Predeclared nonsingular contact and zero-inventory budgets. The reference
# flux is a diagnostic case scale, never a density or velocity floor.
contact_flux_absolute_tolerance_kg_m2_s=1e-20
contact_flux_relative_tolerance=1e-10
contact_flux_reference_kg_m2_s=1e-7
inventory_mass_absolute_tolerance_kg=1e-3
# Separate numerical verification budget for a finite-difference estimate of
# contact-normal velocity. It does not relax the physical mass-flux bound.
contact_normal_velocity_numerical_tolerance=1e-8
# The shock-born downstream drift relaxes from 100% of its RH value to this
# nonzero fraction, avoiding both indefinite ballistic shear and a singular
# zero-volume old-cohort limit. The residual force/work remains diagnostic.
sheath_drift_asymptote_fraction=0.25
sheath_drift_relaxation_time_s=25
