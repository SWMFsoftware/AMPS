! Named cases consume complete source data; fitting methods are not runtime controls.
! Configure the root with Config.pl -model-data-path=/absolute/path/to/studies.
! This example source set initially contains the explicitly selected E3 H2O case.
! Other declared cases remain MISSING_PUBLICATION until their source files are selected upstream.
! All lengths/cell widths are metres in IAU_ENCELADUS. Mesh controls below are independent of TESTMODE.
! Numerical settings retain the prior user controls; this is not a convergence qualification.
#begin application: enceladus
schema_version=3
source_set=enceladus_sources_20261113
reaction_products=discard
solar_activity=active
plasma_background_mode=none
sample_length_steps=1000
total_iterations=10000
volume_field_output=false
particle_splitting_merging=off
random_seed=184467
mesh.domain_min_m=-1260500,-1260500,-1260500
mesh.domain_max_m=1260500,1260500,1260500
mesh.background_cell_size_m=600000
mesh.surface_cell_size_north_m=300000
mesh.surface_cell_size_south_m=150000
mesh.south_polar_half_angle_deg=45
mesh.south_polar_cell_size_m=300000

#begin case: E3--tenishev2014_hybrid_8
