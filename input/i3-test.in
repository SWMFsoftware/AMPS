! Runtime input of the I3 nightly regression test (MakefileTest/Table, test "i3").
!
! Derived from input/i3.in (generated by srcHartley2/i3/prepare_i3_cases.py): the
! global block and cases 1 and 5 are copied unchanged, except for the run controls
! marked "test:" below. The executable is the production DIM1 build of input/i3.conf:
!   ./Config.pl -application=i3 -amps-test=off && rm -rf build && make amps
!   cd case1 && mpirun -np 4 ../amps -i ../i3-test.in -case 1
!   cd case5 && mpirun -np 4 ../amps -i ../i3-test.in -case 5
!
! Each case runs 10000 iterations, which is one sampling window: the output out=0
! (seven radial profiles and the H Lyman-alpha and OH 308.5-nm brightness profiles)
! is written at iteration 10000. The run ends at the iteration limit, before the
! convergence test can be applied; the test compares that output with its
! references (SWMF_data PT/AMPS/data/output/test_i3/*.ref_np<N>.gz).
!
! Case 1 (Pre-Mars Closest Approach, 1.75 AU) has the largest heliocentric
! radial velocity (-39.7 km/s) and the lowest water production (3.2e28 s^-1) of
! the six cases; case 5 (Perihelion, 1.36 AU) is close to zero velocity
! (+0.4 km/s, so the Doppler shifts of the particles take both signs) with an
! 11 times higher water production (3.5e29 s^-1) and a more collisional coma.

#begin application: comet
  schema = 1
  geometry = spherical

  source.H2O.distribution = uniform
  source.H2O.temperature_k = 175.0
  source.H2O.bulk_speed_m_s = 0.0
  source.CO.distribution = uniform
  source.CO.temperature_k = 175.0
  source.CO.bulk_speed_m_s = 0.0
  source.CO2.distribution = uniform
  source.CO2.temperature_k = 175.0
  source.CO2.bulk_speed_m_s = 0.0

  collision.temperature_floor_k = 175.0
  collision.minimum_sample_particles = 1.0
  chemistry.enabled = true
  chemistry.residual_sampling = systematic
  diagnostics.enabled = true
  cooling.H2O.model = GOMBOSI1986_H2O

  nucleus.radius_m = 2500
  mesh.outer_radius_m = 3000000000
  mesh.radial_cell_count = 2000
  ! test: 59 in input/i3.in. It sets the number of model particles (about 1.9e5 at
  ! iteration 10000) and so the run time: 3.8 + 6.7 min for cases 1 and 5 on 4
  ! MPI processes, 2.7 + 4.0 min on 8 (AMD EPYC 7763, GCC 11.5, 2026-11-16).
  simulation.reference_injection_particles = 8
  simulation.courant_number = 0.8
  simulation.inner_boundary_temperature_k = 175.0
  ! test: one sampling window of 10000 iterations, and 10000 iterations in all
  ! (input/i3.in: windows of 10000, at most 150000 iterations).
  simulation.sampling_length = 10000
  simulation.weight_adaptation_enabled = true
  simulation.weight_adaptation_interval = 10000
  simulation.particles_per_cell.minimum = 800
  simulation.particles_per_cell.maximum = 3200
  simulation.chemical_only_particles_per_cell.minimum = 50
  simulation.chemical_only_particles_per_cell.maximum = 200
  simulation.lock_direct_source_weights = true
  simulation.emergency_buffer_utilization = 0.75
  simulation.allocation_low_watermark = 0.50
  simulation.allocation_reserve_fraction = 0.10
  simulation.max_face_transfer_multiplicity = 1
  simulation.max_photochemical_products_per_reaction = 20
  simulation.load_balance_interval = 50
  simulation.max_iterations = 10000
  simulation.convergence_tolerance = 0.05
  simulation.convergence_windows = 3
  transport.characteristic_speed.H_m_s = 49045
  transport.characteristic_speed.H2_m_s = 20883
  transport.characteristic_speed.O_m_s = 6760
  transport.characteristic_speed.OH_m_s = 4097
  transport.characteristic_speed.H2O_m_s = 2500
  transport.characteristic_speed.CO_m_s = 2500
  transport.characteristic_speed.CO2_m_s = 2500

  brightness.enabled = true
  brightness.impact_parameter_grid = LOG | 2500.0 | 3000000000 | 200
  brightness.velocity_domain_policy = ABORT
  brightness.emission.OH = OH | OH_A2SIGMA_X2PI_00 | OH_AX00_SA1988_LOWELL_UNQUENCHED | CORE_SCHLEICHER_AHEARN1988_LOWELL | THIN | ISOTROPIC_4PI | NONE | 0 | 0 | NONE | 308.5
  brightness.emission.H = H | H_LYMAN_ALPHA | H_LYA_IKL2020 | CORE_IKL2020_CASE_SOLAR_FLUX | THIN | ISOTROPIC_4PI | LINE_CENTER | 9.5e-18 | 0.1 | DOPPLER_B8KMS_FOSC0.4164_CONSERVATIVE_DIAGNOSTIC | 0
  dust.enabled = false

  #begin case: 1
    case.index = 1
    case.campaign_phase = Pre-Mars Closest Approach
    case.observation_start_utc = 2025-09-28T17:45:26Z
    case.observation_end_utc = 2025-09-29T05:43:12Z
    case.exposure_mean_f107p_sfu = 136.194566908
    heliocentric_distance_au = 1.75
    random_seed = 104730
    source.H2O.rate_s-1 = 3.160e+28
    source.CO.rate_s-1 = 2.844e+28
    source.CO2.rate_s-1 = 1.185e+28
    ! Minimum mixture mean free path at the 175-K surface: CO2.
    mesh.surface_resolution_m = 0.443700023554
    chemistry.rate.H2O_H_OH_1au_s-1 = 1.17084889035e-05
    chemistry.rate.H2O_H2_O_1au_s-1 = 1.05577172537e-06
    chemistry.rate.H2O_2H_O_1au_s-1 = 1.40769563383e-06
    chemistry.rate.OH_O3P_H_1au_s-1 = 5.30525097633e-06
    chemistry.rate.OH_O1S_H_1au_s-1 = 1.02057933453e-06
    chemistry.rate.OH_O1D_H_1au_s-1 = 7.70610656545e-06
    chemistry.rate.H2_2H_EXCITED_1au_s-1 = 6.04136042853e-08
    chemistry.rate.H2_2H_1au_s-1 = 7.98244607218e-08
    chemistry.rate.H2O_OHPLUS_H_ION_1au_s-1 = 1.14419944817e-07
    chemistry.rate.H2O_OPLUS_H2_ION_1au_s-1 = 1.13852806818e-08
    chemistry.rate.H2O_HPLUS_OH_ION_1au_s-1 = 2.63354225251e-08
    chemistry.rate.H2O_ION_1au_s-1 = 6.62933316955e-07
    chemistry.rate.OH_ION_1au_s-1 = 4.32434249274e-07
    chemistry.rate.H2_ION_1au_s-1 = 1.24139734071e-07
    chemistry.rate.H2_DISS_ION_1au_s-1 = 1.71338893537e-08
    chemistry.rate.H_ION_1au_s-1 = 1.09535059474e-07
    chemistry.rate.O_ION_1au_s-1 = 4.87041120013e-07
    brightness.observation_geometry = -0.546656520072639 | -0.833039569848657 | 0.084921870730915 | 0.0333897515381367 | 0.847084960232127 | -0.530407574079366 | -0.814915305671808 | -0.284170871344927 | -0.505133606544733
    brightness.heliocentric_radial_velocity_km_s = -39.7
    brightness.solar_lya_flux_1au_photon_cm-2_s-1 = 5.1040518742e11
  #end case

  #begin case: 5
    case.index = 5
    case.campaign_phase = Perihelion
    case.observation_start_utc = 2025-10-28T04:59:25Z
    case.observation_end_utc = 2025-10-31T06:05:51Z
    case.exposure_mean_f107p_sfu = 150.444624050
    heliocentric_distance_au = 1.36
    random_seed = 104734
    source.H2O.rate_s-1 = 3.500e+29
    source.CO.rate_s-1 = 1.500e+28
    source.CO2.rate_s-1 = 6.250e+27
    ! Minimum mixture mean free path at the 175-K surface: CO2 = 0.0981878134549 m; floored at the finest 30-level AMR cell.
    mesh.surface_resolution_m = 0.352738131187
    chemistry.rate.H2O_H_OH_1au_s-1 = 1.19914831734e-05
    chemistry.rate.H2O_H2_O_1au_s-1 = 1.09427910745e-06
    chemistry.rate.H2O_2H_O_1au_s-1 = 1.45903880993e-06
    chemistry.rate.OH_O3P_H_1au_s-1 = 5.33649037539e-06
    chemistry.rate.OH_O1S_H_1au_s-1 = 1.0578031372e-06
    chemistry.rate.OH_O1D_H_1au_s-1 = 7.97922886759e-06
    chemistry.rate.H2_2H_EXCITED_1au_s-1 = 6.26170822594e-08
    chemistry.rate.H2_2H_1au_s-1 = 8.38966149672e-08
    chemistry.rate.H2O_OHPLUS_H_ION_1au_s-1 = 1.23286181567e-07
    chemistry.rate.H2O_OPLUS_H2_ION_1au_s-1 = 1.27656568387e-08
    chemistry.rate.H2O_HPLUS_OH_ION_1au_s-1 = 2.87742043131e-08
    chemistry.rate.H2O_ION_1au_s-1 = 7.00924603233e-07
    chemistry.rate.OH_ION_1au_s-1 = 4.62708597075e-07
    chemistry.rate.H2_ION_1au_s-1 = 1.29825023952e-07
    chemistry.rate.H2_DISS_ION_1au_s-1 = 1.87205666616e-08
    chemistry.rate.H_ION_1au_s-1 = 1.14551491723e-07
    chemistry.rate.O_ION_1au_s-1 = 5.20620117721e-07
    brightness.observation_geometry = -0.969662586328084 | -0.235159236702651 | 0.0667428053722478 | 0.571307031301513 | -0.816792754925974 | -0.080360882809299 | -0.816932426948076 | -0.575342762092991 | 0.0400264401106851
    brightness.heliocentric_radial_velocity_km_s = 0.4
    brightness.solar_lya_flux_1au_photon_cm-2_s-1 = 5.4475114410e11
  #end case
#end application
