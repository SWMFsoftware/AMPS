#main

! The neutral prefix is kept in its historical order because the chemistry,
! collision, and IDF fixtures use those generated IDs. H+ and electrons add
! two charged records for constant-field mover tests; no plasma chemistry or
! self-consistent field solve is enabled by their presence.
SpeciesList=H2O,OH,H,O,H2,O2,CO2,H_PLUS,ELECTRON

makefile SOURCES=src
makefile RUNDIR=run
makefile MPIRUN=mpiexec -n 1

ExcludeModule=ELECTRON_IMPACT
ExcludeModule=SPUTTERING
ExcludeModule=DUST
ExcludeModule=CHARGE_EXCHANGE
ExcludeModule=EXOSPHERE
ExcludeModule=SURFACE

ProjectSourceDirectory=test/srcCoreUnitTests
WorkingSourceDirectory=srcTemp
SourceDirectory=src

ErrorLog=PT/amps_error.log
Prefix=AMPS
DiagnosticStream=PT
OutputDirectory=PT/plots

DebuggerMode=off
ForceRepeatableSimulationPath=on
StdoutErrorLog=on

TimeStepMode=SpeciesGlobalTimeStep
ParticleWeightMode=SpeciesGlobalParticleWeight
ParticleWeightCorrectionMode=off
CouplerMode=off

#endmain

#include species.input

#General
  BlockCells=2,2,2
  GhostCells=1,1,1
  Rnd=MersenneTwister
  define _PIC_PHOTOLYTIC_REACTIONS_MODE_ _PIC_PHOTOLYTIC_REACTIONS_MODE_ON_
  define _PIC_VOLUME_PARTICLE_INJECTION_MODE_ _PIC_VOLUME_PARTICLE_INJECTION_MODE__ON_
  ! Retain the three off-diagonal second moments (VxVy,VyVz,VzVx). They are
  ! required to validate the full kinetic pressure tensor rather than only its
  ! scalar trace; the storage cost is bounded to this native test profile.
  define _PIC_SAMPLE__VELOCITY_TENSOR_MODE_ _PIC_MODE_ON_
  NastranSurfaceUserData=off
  ControlParticleInsideNastranSurface=off
  InternalBoundary=on
  ! The application header declares a uniform SI field provider. The
  ! non-relativistic hook is AMPS' existing application force interface; the
  ! relativistic hook has the same role and retains the coupler lookup as its
  ! production default. Tests restore both vectors after every case.
  define _PIC_PARTICLE_MOVER__BORIS_SPLIT_ACCELERATION_(acceleration,rotation,species,particle,position,velocity,node) ::AMPS::CoreTests::BorisUniformFieldAcceleration(acceleration,rotation,species,particle,position,velocity,node)
  define _PIC_PARTICLE_MOVER__RELATIVISTIC_BORIS_GET_FIELDS_(electric_field,magnetic_field) ::AMPS::CoreTests::RelativisticBorisUniformFields(electric_field,magnetic_field)
#endGeneral

! AMPS' mesh types inherit the surface-data classes installed by the
! exosphere input generator whenever spherical user data is enabled.  The
! target-free block supplies those type definitions without enabling any
! exosphere source, boundary, or SPICE behavior in this core test fixture.
#block ../exosphere.pl
  SPICE=off
  define _TARGET_ _TARGET_NONE_
  addPhysicalModelHeader=core_test_fields.h
#endblock

! NTC is enabled so the configured production collision subsystem is linked
! and initialized. Kernel tests exercise pair scattering; the populated-cell
! case selects collision pairs, updates real particle records, and relaxes
! translational energy into rotation.
#ParticleCollisions
  model=NTC
  SampleCollisionFrequency=on
  CollisionCrossSection=const \\
    const(H2O,H2O)=3.4E-19 \\
    const(H2O,O)=3.4E-19 \\
    const(O,O)=3.4E-19
#endParticleCollisions

! Classical Larsen-Borgnakke storage and equilibrium samplers. Mode counts
! are molecular degrees of freedom: 3N-6 for nonlinear H2O vibration and
! 3N-5 for linear molecules. RT is active for the populated H2O collision
! cell. VT remains off because the production VT path declares itself
! unverified; enabling it would terminate rather than provide valid coverage.
#IDF
  Model=LB
  vtRelaxation=off
  vvRelaxation=off
  rtRelaxation=on

  nVibModes(H2O=3)
  nVibModes(OH=1)
  nVibModes(H=0)
  nVibModes(O=0)
  nVibModes(H2=1)
  nVibModes(O2=1)
  nVibModes(CO2=4)

  nRotModes(H2O=3)
  nRotModes(OH=2)
  nRotModes(H=0)
  nRotModes(O=0)
  nRotModes(H2=2)
  nRotModes(O2=2)
  nRotModes(CO2=2)

  RotZnum(H2O=5)
  RotZnum(OH=5)
  RotZnum(H2=5)
  RotZnum(O2=5)
  RotZnum(CO2=5)

  TemperatureIndex(H2O,H2O)=0.5
  TemperatureIndex(H2O,O)=0.5

  VibTemp(H2O=200,300,400)
  VibTemp(OH=500)
  VibTemp(H2=600)
  VibTemp(O2=700)
  VibTemp(CO2=800,900,1000,1100)
#endIDF

! Deliberately terminate at EOF rather than #end.  ampsConfig.pl treats EOF as
! a valid end of input, while derived compile profiles may include this deck,
! append one narrowly scoped override (for example VHS/VSS), and supply their
! own final #end.  This avoids duplicating the complete native physics fixture.
