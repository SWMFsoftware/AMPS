#main

! T6 reaction profile.  The seven neutral species retain their historical
! indices. H+ and electron retain the T4 suffix positions, while the five ion
! daughters are appended so Burger reaction products are real compiled
! species rather than negative unavailable sentinels.
SpeciesList=H2O,OH,H,O,H2,O2,CO2,H_PLUS,ELECTRON,H2O_PLUS,OH_PLUS,O_PLUS,O2_PLUS,H2_PLUS

makefile SOURCES=src
makefile RUNDIR=run
makefile MPIRUN=mpiexec -n 1

IncludeModule=ELECTRON_IMPACT
IncludeModule=CHARGE_EXCHANGE
ExcludeModule=SPUTTERING
ExcludeModule=DUST
ExcludeModule=EXOSPHERE
ExcludeModule=SURFACE

ProjectSourceDirectory=test/srcCoreUnitTests
WorkingSourceDirectory=srcTemp
SourceDirectory=src

ErrorLog=PT/amps_error.log
Prefix=AMPS
DiagnosticStream=PT
OutputDirectory=PT/plots

DebuggerMode=off
ForceRepeatableSimulationPath=on
StdoutErrorLog=on

TimeStepMode=SpeciesGlobalTimeStep
ParticleWeightMode=SpeciesGlobalParticleWeight
ParticleWeightCorrectionMode=off
CouplerMode=off

#endmain

#include species.input

#General
  BlockCells=2,2,2
  GhostCells=1,1,1
  Rnd=MersenneTwister
  define _AMPS_CORE_TEST_T6_REACTIONS_ 1
  define _PIC_PHOTOLYTIC_REACTIONS_MODE_ _PIC_PHOTOLYTIC_REACTIONS_MODE_ON_
  define _PIC_VOLUME_PARTICLE_INJECTION_MODE_ _PIC_VOLUME_PARTICLE_INJECTION_MODE__ON_
  define _PIC_SAMPLE__VELOCITY_TENSOR_MODE_ _PIC_MODE_ON_
  NastranSurfaceUserData=off
  ControlParticleInsideNastranSurface=off
  InternalBoundary=on
  define _PIC_PARTICLE_MOVER__BORIS_SPLIT_ACCELERATION_(acceleration,rotation,species,particle,position,velocity,node) ::AMPS::CoreTests::BorisUniformFieldAcceleration(acceleration,rotation,species,particle,position,velocity,node)
  define _PIC_PARTICLE_MOVER__RELATIVISTIC_BORIS_GET_FIELDS_(electric_field,magnetic_field) ::AMPS::CoreTests::RelativisticBorisUniformFields(electric_field,magnetic_field)
#endGeneral

! The target-free block installs the mesh user-data types required by the
! native PIC headers but enables no exosphere source or SPICE behavior.
#block ../exosphere.pl
  SPICE=off
  define _TARGET_ _TARGET_NONE_
  addPhysicalModelHeader=core_test_fields.h
#endblock

! Collision/IDF settings mirror the baseline profile. They keep the shared
! application translation units valid while T6 selects only reaction cases.
#ParticleCollisions
  model=NTC
  SampleCollisionFrequency=on
  CollisionCrossSection=const \\
    const(H2O,H2O)=3.4E-19 \\
    const(H2O,O)=3.4E-19 \\
    const(O,O)=3.4E-19
#endParticleCollisions

#IDF
  Model=LB
  vtRelaxation=off
  vvRelaxation=off
  rtRelaxation=on

  nVibModes(H2O=3)
  nVibModes(OH=1)
  nVibModes(H=0)
  nVibModes(O=0)
  nVibModes(H2=1)
  nVibModes(O2=1)
  nVibModes(CO2=4)

  nRotModes(H2O=3)
  nRotModes(OH=2)
  nRotModes(H=0)
  nRotModes(O=0)
  nRotModes(H2=2)
  nRotModes(O2=2)
  nRotModes(CO2=2)

  RotZnum(H2O=5)
  RotZnum(OH=5)
  RotZnum(H2=5)
  RotZnum(O2=5)
  RotZnum(CO2=5)

  TemperatureIndex(H2O,H2O)=0.5
  TemperatureIndex(H2O,O)=0.5

  VibTemp(H2O=200,300,400)
  VibTemp(OH=500)
  VibTemp(H2=600)
  VibTemp(O2=700)
  VibTemp(CO2=800,900,1000,1100)
#endIDF

! ChargeExchange.dfn defaults to Lindsay--Stebbings. The test profile records
! that generated selector explicitly in its retained configuration evidence;
! both published laws are exercised directly by the same executable.
