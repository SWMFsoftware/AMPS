  ambient.alpha_temperature = 606239.7142176646 K
  ambient.thermodynamic_closure = multi_species
  parker.radial_polarity = 1
  parker.sin_theta = 0.9947231424277913
  parker.source_radius = 1.1 Rs
  cme.kinematics = data_driven
  cme.data_times = 0.0 s, 600.0 s, 720.0 s, 1380.0 s, 225999.0 s
