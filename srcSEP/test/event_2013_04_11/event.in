! srcSEP schema-6 runtime deck for the 2013-04-11 real-event test, LONG tier (full event).
! GENERATED by srcSEP/test/event_2013_04_11/prepare_event.py deck; do not edit.
! Model time 0 = 2013-04-11T07:26:44.000Z.  Run with --reduced-shock-event event.event:
! the shared reduced core then owns B, U, rho, T and the shock everywhere.
#begin run
  time_step_s = 60.0
  maximum_time_steps = 2484
#end run

#begin application: sep
  schema_version = 6
  ! The mover is selected on the command line (--particle-mover).
  transport = parker
  #begin turbulence
    ! Transport coefficients come from the prescribed lambda law on the
    ! command line; the turbulence state is prescribed and not evolved.
    source = prescribed
    representation = integrated
    coupling = disabled
    advection = false
    reflection = false
    cascade = false
    shock_injection = false
    inner_boundary = fixed-reservoir
    inner_boundary_value_si = 0
    outer_boundary = fixed-reservoir
    outer_boundary_value_si = 0
    reflection_coefficient = 0.6
    cascade_coefficient = 0.8
    perpendicular_correlation_length_m = 1e7
    electron_heating_fraction = 0.3
    spectral_k_min_per_m = 1e-10
    spectral_k_max_per_m = 1e-2
    spectral_bins = 128
    cfl_safety = 0.8
    operator_accuracy_safety = 0.25
    maximum_source_fraction = 0.25
    maximum_cascade_fraction = 0.2
    minimum_substep_s = 1e-12
    maximum_substeps = 1000000
    conservation_relative_tolerance = 1e-12
    shock_source_efficiency = 0.02
    shock_source_plus_fraction = 0.5
    diagnostic_cadence_steps = 0
  #end turbulence
#end application

#begin mesh
  global_cell_size_m = 74798935350.0
  minimum_cell_size_m = 191317500.00000003
  maximum_level = 12
  #begin field_line
    origin_x_m = 0
    origin_y_m = 0
    origin_z_m = 0
    ! The line through Earth at t0: srcSEP traces the core field from this
    ! point sunward to inner_radius_m and starts the line there.
    anchor_x_m = 149175624283.73193
    anchor_y_m = 0.0
    anchor_z_m = -15385961496.785349
    ! Arc length: PFSS shell depth + exterior spiral to 2.05 AU (beyond the outer sphere).
    length_m = 478335991813.18805
    ! Geometric spacing, chord ~ 0.02 r (first arc 0.02 r_base, growth ~1+0.02).
    point_count = 326
    first_segment_length_m = 15305400.000000002
  #end field_line
  #begin domain
    inner_radius_m = 765270000.0000001
    outer_radius_m = 299195741400.0
  #end domain
  #begin refinement: solar
    enabled = true
    surface_cell_size_m = 191317500.00000003
    transition_outer_radius_m = 6957000000.0
    profile = smoothstep
    exponent = 1
  #end refinement
  #begin refinement: tube
    enabled = true
    reference_radius_m = 149597870700.0
    radius_at_reference_m = 5983914828.0
    radius_mode = constant-angular-width
    center_cell_size_m = 2991957414.0
    transverse_profile = smoothstep
    transverse_exponent = 1
  #end refinement
#end mesh

#begin physics: background
  provider = swcme
#end physics
#begin physics: shock
  authority = swcme
#end physics

! Required by schema 6 and cross-checked against the line geometry (wind
! speed, base radius, colatitude).  With --reduced-shock-event the shared
! core replaces this state at every vertex; values are the measured ones.
#begin physics: swcme
  preset = fast
  ambient.wind_speed = 377.9481478604403 km/s
  ambient.density_1au = 6.237754438379548 cm^-3
  ambient.magnetic_field_1au = 6.978105838584368 nT
  ambient.proton_temperature = 62502.057627118644 K
  ambient.adiabatic_index = 1.6666666666666667
