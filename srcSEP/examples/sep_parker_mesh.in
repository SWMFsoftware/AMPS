# srcSEP complete startup configuration, schema version 2.
#
# Every dimensional key includes its SI unit.  The parser rejects unknown,
# duplicate, and omitted keys before MPI/AMPS initialization.  The finite line
# remains a one-dimensional particle-transport domain embedded in the 3-D AMR
# support mesh.

[run]
schema_version = 2
# The PIC clock step is explicit.  It is installed for every compiled AMPS
# species on every block and is never re-derived from the AMR cell size.
time_step_s = 1

[injection]
# Exact macroparticle count per active field-line source event.  The individual
# AMPS weight correction carries the physical-rate/count ratio.
macroparticles_per_step = 1000

[species]
# Common base statistical weight installed for every entry in AMPS' generated
# SpeciesList.  This runtime file does not redefine species identity, mass, or
# charge.  The shock-source correction is species-aware and multiplies this
# base value without changing conservation.
particle_weight = 1e30

[observer]
# srcSEP's retained observer is a radius on its one-dimensional field line.
heliocentric_radius_m = 1.495978707e11

[output]
# Both products are emitted after final mesh pruning/decomposition.
# With --initialization-output-dir DIR, these leaf names are retained and only
# their parent is replaced. --initialization-only then exits before time step 1.
mesh_tecplot_file = srcsep-initialization-mesh.dat
field_line_tecplot_file = srcsep-initialization-field-line.dat

[parker_spiral]
# Origin of the Parker geometry and first point on the inner boundary sphere.
# length_m is physical arc length; point_count includes both endpoints.
origin_x_m = 0
origin_y_m = 0
origin_z_m = 0
initial_x_m = 1.3914e10
initial_y_m = 0
initial_z_m = 0
length_m = 2.0e11
point_count = 4001

[domain]
# The AMR root is the cube origin +/- outer_radius_m.  inner_radius_m must
# equal the distance from Parker origin to the initial point.
inner_radius_m = 1.3914e10
outer_radius_m = 1.495978707e11

[mesh]
# global_cell_size_m is the asymptotic background request.  The minimum is a
# hard floor shared by the solar and tube refinement profiles.
global_cell_size_m = 3.7399467675e10
minimum_cell_size_m = 1.495978707e9
maximum_level = 7

[mesh.solar]
# Cell size changes monotonically from surface_cell_size_m at the inner sphere
# to the global size at transition_outer_radius_m.  profile is linear,
# power-law, or smoothstep; exponent controls how quickly it degrades.
enabled = true
surface_cell_size_m = 1.495978707e9
transition_outer_radius_m = 3.7399467675e10
profile = smoothstep
exponent = 1

[mesh.tube]
# At the analytic Parker centreline the requested cell size is
# center_cell_size_m.  It becomes exactly global at the tube boundary.
# constant-angular-width scales the physical radius linearly with heliocentric
# radius; physical-constant retains radius_at_reference_m everywhere.
enabled = true
reference_radius_m = 1.495978707e11
radius_at_reference_m = 4.487936121e9
radius_mode = constant-angular-width
center_cell_size_m = 1.495978707e9
transverse_profile = smoothstep
transverse_exponent = 1

[background.parker]
# These values determine both the field-line winding and the magnetic tangent.
solar_wind_speed_m_per_s = 400000
# SWCME1D uses its documented Carrington sidereal rate as canonical physics;
# this application-owned mesh value must match it exactly.
solar_rotation_rate_rad_per_s = 2.86533e-6

[swcme]
# Complete canonical SWCME1D assignment layer.  Units are interpreted only by
# src/models/swcme/swcme1d_input.hpp.  Every physically effective key is
# explicit; there are no hidden CME/source defaults in a version-2 run.
preset = fast
ambient.wind_speed = 400 km/s
ambient.density_1au = 6 cm^-3
ambient.magnetic_field_1au = 5 nT
ambient.proton_temperature = 1.2e5 K
ambient.adiabatic_index = 1.6666666666666667
ambient.alpha_to_proton_ratio = 0.04
ambient.electron_temperature = 1.2e5 K
ambient.alpha_temperature = 4.8e5 K
ambient.thermodynamic_closure = proton_only
parker.radial_polarity = 1
parker.sin_theta = 1
parker.source_radius = 20 Rs
cme.kinematics = dbm
cme.launch_radius = 20 Rs
cme.launch_speed = 1900 km/s
cme.drag_coefficient = 8e-8 1/km
cme.extrapolation = outside_time
shock.region_mode = shock_only
shock.acceleration_mode = source
shock.relative_source_weight_per_area = 1
geometry.sheath_thickness_1au = 0.12 AU
geometry.ejecta_thickness_1au = 0.22 AU
smoothing.shock_width_1au = 0.010 AU
smoothing.leading_edge_width_1au = 0.020 AU
smoothing.trailing_edge_width_1au = 0.030 AU
sheath.ramp_power = 2
sheath.leading_edge_speed_factor = 1.12
ejecta.density_factor = 0.50
ejecta.speed_factor = 0.80
event.launch_epoch = 0 s
event.valid_from = 0 s
event.valid_until = 604800 s
source.particle_mass = 1 mp
source.charge_number = 1
source.energy_min = 0.1 MeV
source.energy_max = 500 MeV
source.reference_energy = 10 MeV
source.injection_efficiency = 3.4e-4
source.normalization = relative_only
# Required for a complete auditable input but inactive under relative_only.
source.reference_intensity_si = 1 si
