#ifndef SHIELDSIM_BUILD_PROVENANCE_HH
#define SHIELDSIM_BUILD_PROVENANCE_HH

/* Generated by CMake. These strings are copied into every resolved run
 * manifest so a binary's compiler/platform/source identity is not guessed
 * later from the directory in which results happen to reside. */
namespace shield_sim_build {
inline constexpr const char* GitRevision = R"prov(@SHIELDSIM_GIT_REVISION@)prov";
inline constexpr const char* GitState = R"prov(@SHIELDSIM_GIT_STATE@)prov";
inline constexpr const char* Compiler = R"prov(@CMAKE_CXX_COMPILER_ID@ @CMAKE_CXX_COMPILER_VERSION@)prov";
inline constexpr const char* BuildType = R"prov(@CMAKE_BUILD_TYPE@)prov";
inline constexpr const char* CompilerFlags = R"prov(@CMAKE_CXX_FLAGS@ @SHIELDSIM_BUILD_TYPE_FLAGS@)prov";
inline constexpr const char* Platform = R"prov(@CMAKE_SYSTEM_NAME@/@CMAKE_SYSTEM_PROCESSOR@)prov";
}
#endif
