! Roadmap Step 8 workflow smoke input.  The campaign renderer replaces only the
! two explicit placeholders below; all numerical controls remain reviewable text.
#RUN_INFO
  RUN_ID step8_campaign_{{EPOCH_TOKEN}}

#CALCULATION_MODE
  CALC_TARGET CUTOFF_RIGIDITY+DENSITY_SPECTRUM
  FIELD_EVAL_METHOD GRIDLESS

#BACKGROUND_FIELD
  FIELD_MODEL {{FIELD_MODEL}}
  DIPOLE_MOMENT 1.0
  DIPOLE_TILT 0.0
  EPOCH {{EPOCH_UTC}}

#ELECTRIC_FIELD
  EFIELD_MODEL NONE

#PARTICLE_SPECIES
  SPECIES PROTON
  CHARGE 1
  MASS_AMU 1.007276466621

#DOMAIN_BOUNDARY
  DOMAIN_X_MIN -127424.0
  DOMAIN_X_MAX  127424.0
  DOMAIN_Y_MIN -127424.0
  DOMAIN_Y_MAX  127424.0
  DOMAIN_Z_MIN -127424.0
  DOMAIN_Z_MAX  127424.0
  R_INNER 6434.9

#CUTOFF_RIGIDITY
  CUTOFF_EMIN 1.0
  CUTOFF_EMAX 1000.0
  CUTOFF_NENERGY 24
  CUTOFF_SAMPLING VERTICAL
  CUTOFF_SEARCH_ALGORITHM DIRECT_ACCESS
  CUTOFF_RIGIDITY_LIST_GV 0.10 0.30 1.0 3.0 10.0 30.0
  CUTOFF_BACKTRACE_CHARGE REVERSED
  CUTOFF_TRACE_LIMIT_POLICY UNRESOLVED
  CUTOFF_DIRECT_ACCESS_ADAPTIVE F
  DIRECTIONAL_MAP T
  DIRMAP_COVERAGE FULL_SPHERE
  DIRMAP_LON_RES 30.0
  DIRMAP_LAT_RES 30.0

#DENSITY_SPECTRUM
  DS_EMIN 1.0
  DS_EMAX 1000.0
  DS_NINTERVALS 48
  DS_ENERGY_SPACING LOG
  DS_BOUNDARY_MODE ISOTROPIC
  DS_TRANSMISSION_MODE SCAN
  DS_TRANSMISSION_SCAN_N 48
  DS_TRANSMISSION_SAVE T
  DS_MAX_PARTICLES 512
  DS_MAX_TRAJ_TIME 300.0
  DS_UNRESOLVED_TOL 0.01
  DS_RETRY_UNRESOLVED T
  DS_SAVE_TERMINATION_SUMMARY T
  DS_FAIL_ON_UNRESOLVED T

#SPECTRUM
  SPECTRUM_TYPE POWER_LAW
  SPEC_J0 1.0
  SPEC_E0 10.0
  SPEC_GAMMA 3.5
  SPEC_EMIN 1.0
  SPEC_EMAX 1000.0
  SPEC_ENERGY_BASIS PER_PARTICLE
  SPEC_INTENSITY_UNIT M^-2_S^-1_SR^-1_MEV^-1
  SPEC_MASS_NUMBER 1
  SPEC_RELATIVE_UNCERTAINTY 0.10

#BOUNDARY_ANISOTROPY
  BA_PAD_MODEL ISOTROPIC
  BA_PAD_EXPONENT 0.0
  BA_PAD_NORMALIZATION UNIT_MEAN
  BA_SPATIAL_MODEL UNIFORM
  BA_SPATIAL_NORMALIZATION UNIT_MEAN

#ENERGY_CHANNELS
  CH_BEGIN
    P5 38.0 82.0
  CH_END

#DETECTOR_RESPONSES
  ! Identical response channels give an exact unit-ratio workflow reference.
  DR_BEGIN
    GOES_P5_E 38.0 82.0 1.0e-4
    GOES_P5_W 38.0 82.0 1.0e-4
  DR_END

#OUTPUT_DOMAIN
  OUTPUT_MODE POINTS
  COORDS GSM
  POINTS_BEGIN
    POINT 42164.0 0.0 0.0
  POINTS_END

#NUMERICAL
  DT_TRACE 0.1
  ADAPTIVE_DT T
  MAX_STEPS 300000
  MAX_TRACE_TIME 300.0
  MAX_TRACE_DISTANCE 0.0
  BOUNDARY_EVENT_TOL_M 1.0
  BOUNDARY_EVENT_MAX_ITER 40
  TRAP_DETECTION T
  GRIDLESS_MPI_SCHEDULER DYNAMIC
  GRIDLESS_MPI_DYNAMIC_CHUNK 0
