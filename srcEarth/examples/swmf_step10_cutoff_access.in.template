!===============================================================================
! Roadmap Step 10 live SWMF cutoff/access template.
!
! This is a configuration template for an AMPS component built and launched by
! SWMF, not a standalone `./amps` input. Replace every REPLACE_* token with the
! coupled campaign value. Preserve the resulting file with the exported snapshot
! so standalone replay can use exactly the same particle/product controls.
!===============================================================================

#RUN_INFO
  RUN_ID step10_live_swmf_cutoff_access

#CALCULATION_MODE
  CALC_TARGET CUTOFF_RIGIDITY
  FIELD_EVAL_METHOD GRID_3D

#BACKGROUND_FIELD
  FIELD_MODEL SWMF
  EPOCH REPLACE_WITH_COUPLED_REFERENCE_EPOCH_UTC
  SWMF_SNAPSHOT_EXPORT T
  SWMF_SNAPSHOT_EXPORT_PREFIX swmf_field_snapshot
  ! Phase-1 release mode. EXPERIMENTAL does not release a time-dependent mover.
  SWMF_DERIVED_ELECTRIC_FIELD OFF
  ! Used only when BOUNDARY_TYPE SHUE has AUTO parameters.
  PDYN REPLACE_WITH_UPSTREAM_DYNAMIC_PRESSURE_NPA
  IMF_BZ REPLACE_WITH_UPSTREAM_IMF_BZ_NT

#ELECTRIC_FIELD
  EFIELD_MODEL NONE

#PARTICLE_SPECIES
  SPECIES PROTON
  CHARGE 1
  MASS_AMU 1.007276466621

#TEMPORAL
  ! Minutes between requested coupled cutoff/access products. Scheduling uses the
  ! authoritative PT simulation clock, not the number of coupling callbacks.
  FIELD_UPDATE_DT REPLACE_WITH_PRODUCT_CADENCE_MIN

#DOMAIN_BOUNDARY
  DOMAIN_X_MIN REPLACE_WITH_LIVE_XMIN_KM
  DOMAIN_X_MAX REPLACE_WITH_LIVE_XMAX_KM
  DOMAIN_Y_MIN REPLACE_WITH_LIVE_YMIN_KM
  DOMAIN_Y_MAX REPLACE_WITH_LIVE_YMAX_KM
  DOMAIN_Z_MIN REPLACE_WITH_LIVE_ZMIN_KM
  DOMAIN_Z_MAX REPLACE_WITH_LIVE_ZMAX_KM
  R_INNER REPLACE_WITH_LIVE_RINNER_KM
  ! BOX: all six faces are physical escape.
  ! SHUE: magnetopause plus DOMAIN_X_MIN tail cap; another early mesh-face hit is
  ! INVALID_FIELD. SHUE_R0 is AUTO or Re; SHUE_ALPHA is AUTO or dimensionless.
  BOUNDARY_TYPE BOX
  !SHUE_R0 AUTO
  !SHUE_ALPHA AUTO

#OUTPUT_DOMAIN
  ! POINTS, TRAJECTORY, and SHELLS use the same production solver as standalone.
  OUTPUT_MODE POINTS
  COORDS GSM
  POINTS_BEGIN
    POINT REPLACE_X_KM REPLACE_Y_KM REPLACE_Z_KM
  POINTS_END

#CUTOFF_RIGIDITY
  CUTOFF_EMIN REPLACE_WITH_LIVE_VALUE
  CUTOFF_EMAX REPLACE_WITH_LIVE_VALUE
  CUTOFF_NENERGY REPLACE_WITH_LIVE_VALUE
  CUTOFF_SAMPLING REPLACE_WITH_VERTICAL_OR_ISOTROPIC
  ! Use DIRECT_ACCESS plus the unchanged directional controls for A(E,Omega), or
  ! retain the established scalar cutoff search used by the validation profile.
  CUTOFF_SEARCH_ALGORITHM REPLACE_WITH_LIVE_VALUE
  CUTOFF_TRACE_LIMIT_POLICY UNRESOLVED

#NUMERICAL
  DT_TRACE REPLACE_WITH_LIVE_VALUE
  ADAPTIVE_DT REPLACE_WITH_LIVE_VALUE
  MAX_STEPS REPLACE_WITH_LIVE_VALUE
  MAX_TRACE_TIME REPLACE_WITH_LIVE_VALUE
  MAX_TRACE_DISTANCE REPLACE_WITH_LIVE_VALUE
  MODE3D_MPI_SCHEDULER REPLACE_WITH_DYNAMIC_BLOCK_CYCLIC_OR_STATIC
  DENSITY_PARALLEL REPLACE_WITH_OPENMP_THREADS_OR_SERIAL
  DENSITY_THREADS REPLACE_WITH_LIVE_VALUE
