!===============================================================================
! Roadmap Step 11 live SWMF cutoff + flux/spectrum template.
!
! This file is consumed by an AMPS component launched through SWMF/PT; it is not a
! standalone ./amps input. Replace every REPLACE_* token and archive the fully
! resolved file beside the exported field, status, cutoff/access manifest, Step-11
! flux/spectrum manifest, and numeric artifacts. The offline replay must use the
! identical particle, spectrum, response, observation, and numerical controls.
!===============================================================================

#RUN_INFO
  RUN_ID step11_live_swmf_flux_spectrum

#CALCULATION_MODE
  CALC_TARGET CUTOFF_RIGIDITY+DENSITY_SPECTRUM
  FIELD_EVAL_METHOD GRID_3D

#BACKGROUND_FIELD
  FIELD_MODEL SWMF
  EPOCH REPLACE_WITH_COUPLED_REFERENCE_EPOCH_UTC
  SWMF_SNAPSHOT_EXPORT T
  SWMF_SNAPSHOT_EXPORT_PREFIX swmf_field_snapshot
  ! Phase-1 release: the characteristic mapping remains static magnetic.
  SWMF_DERIVED_ELECTRIC_FIELD OFF
  PDYN REPLACE_WITH_UPSTREAM_DYNAMIC_PRESSURE_NPA
  IMF_BZ REPLACE_WITH_UPSTREAM_IMF_BZ_NT

#ELECTRIC_FIELD
  EFIELD_MODEL NONE

#PARTICLE_SPECIES
  SPECIES PROTON
  CHARGE 1
  MASS_AMU 1.007276466621

#TEMPORAL
  ! Minutes between requested products. The bridge schedules on authoritative PT
  ! simulation time and stamps every product with the resulting absolute UTC.
  FIELD_UPDATE_DT REPLACE_WITH_PRODUCT_CADENCE_MIN

#DOMAIN_BOUNDARY
  DOMAIN_X_MIN REPLACE_WITH_LIVE_XMIN_KM
  DOMAIN_X_MAX REPLACE_WITH_LIVE_XMAX_KM
  DOMAIN_Y_MIN REPLACE_WITH_LIVE_YMIN_KM
  DOMAIN_Y_MAX REPLACE_WITH_LIVE_YMAX_KM
  DOMAIN_Z_MIN REPLACE_WITH_LIVE_ZMIN_KM
  DOMAIN_Z_MAX REPLACE_WITH_LIVE_ZMAX_KM
  R_INNER REPLACE_WITH_LIVE_RINNER_KM
  BOUNDARY_TYPE REPLACE_WITH_BOX_OR_SHUE
  !SHUE_R0 REPLACE_WITH_LIVE_VALUE_OR_AUTO
  !SHUE_ALPHA REPLACE_WITH_LIVE_VALUE_OR_AUTO

#CUTOFF_RIGIDITY
  CUTOFF_EMIN REPLACE_WITH_LIVE_VALUE
  CUTOFF_EMAX REPLACE_WITH_LIVE_VALUE
  CUTOFF_NENERGY REPLACE_WITH_LIVE_VALUE
  CUTOFF_SAMPLING REPLACE_WITH_VERTICAL_OR_ISOTROPIC
  CUTOFF_SEARCH_ALGORITHM REPLACE_WITH_LIVE_VALUE
  CUTOFF_TRACE_LIMIT_POLICY UNRESOLVED

#DENSITY_SPECTRUM
  DS_EMIN REPLACE_WITH_MINIMUM_SPECTRUM_COORDINATE_MEV
  DS_EMAX REPLACE_WITH_MAXIMUM_SPECTRUM_COORDINATE_MEV
  DS_NINTERVALS REPLACE_WITH_CONVERGED_ENERGY_INTERVAL_COUNT
  DS_ENERGY_SPACING REPLACE_WITH_LOG_OR_LINEAR
  DS_BOUNDARY_MODE REPLACE_WITH_ISOTROPIC_OR_ANISOTROPIC
  DS_TRANSMISSION_MODE REPLACE_WITH_DIRECT_SCAN_OR_ADAPTIVE
  DS_TRANSMISSION_SCAN_N REPLACE_WITH_CONVERGED_SCAN_COUNT
  DS_TRANSMISSION_SAVE T
  DS_MAX_PARTICLES REPLACE_WITH_CONVERGED_DIRECTION_BUDGET
  DS_MAX_TRAJ_TIME REPLACE_WITH_RETAINED_TRACE_LIMIT_S
  ! Preserve the registered gate. Step 11 does not change this value.
  DS_UNRESOLVED_TOL 0.01
  DS_RETRY_UNRESOLVED T
  DS_SAVE_TERMINATION_SUMMARY T
  DS_FAIL_ON_UNRESOLVED T

#SPECTRUM
  ! Replace this example family or table with the frozen campaign definition.
  ! For a TIME_DEPENDENT table, the bridge evaluates the table at the same absolute
  ! UTC as the field snapshot and records the selected/interpolated source rows.
  SPECTRUM_TYPE POWER_LAW
  SPEC_J0 REPLACE_WITH_BOUNDARY_INTENSITY_NORMALIZATION
  SPEC_E0 REPLACE_WITH_REFERENCE_ENERGY_MEV
  SPEC_GAMMA REPLACE_WITH_SPECTRAL_INDEX
  SPEC_EMIN REPLACE_WITH_SPECTRUM_VALIDITY_MIN_MEV
  SPEC_EMAX REPLACE_WITH_SPECTRUM_VALIDITY_MAX_MEV
  SPEC_ENERGY_BASIS PER_PARTICLE
  SPEC_INTENSITY_UNIT M^-2_S^-1_SR^-1_MEV^-1
  SPEC_MASS_NUMBER 1
  SPEC_RELATIVE_UNCERTAINTY REPLACE_WITH_FROZEN_RELATIVE_UNCERTAINTY

#BOUNDARY_ANISOTROPY
  BA_PAD_MODEL ISOTROPIC
  BA_PAD_EXPONENT 0.0
  BA_PAD_NORMALIZATION UNIT_MEAN
  BA_SPATIAL_MODEL UNIFORM
  BA_SPATIAL_NORMALIZATION UNIT_MEAN

#ENERGY_CHANNELS
  ! Replace these bounds with the preregistered model/observation channels.
  CH_BEGIN
    P10_100 10.0 100.0
    P100_1G 100.0 1000.0
  CH_END

#DETECTOR_RESPONSES
  ! Compact top-hat response: NAME E1 E2 angular-integrated geometric factor [m2 sr].
  ! Preserve the resolved schema and fingerprint with every comparison.
  DR_BEGIN
    SYNTH_P10_100 10.0 100.0 1.0e-4
  DR_END

#OUTPUT_DOMAIN
  ! POINTS and SHELLS are static at the field epoch. For TRAJECTORY, each sample must
  ! carry a UTC matching a requested SWMF field epoch within 1 ms; missing matches fail.
  OUTPUT_MODE POINTS
  COORDS GSM
  POINTS_BEGIN
    POINT REPLACE_X_KM REPLACE_Y_KM REPLACE_Z_KM
  POINTS_END

#NUMERICAL
  DT_TRACE REPLACE_WITH_LIVE_VALUE
  ADAPTIVE_DT REPLACE_WITH_LIVE_VALUE
  MAX_STEPS REPLACE_WITH_LIVE_VALUE
  MAX_TRACE_TIME REPLACE_WITH_LIVE_VALUE
  MAX_TRACE_DISTANCE REPLACE_WITH_LIVE_VALUE
  BOUNDARY_EVENT_TOL_M REPLACE_WITH_LIVE_VALUE
  BOUNDARY_EVENT_MAX_ITER REPLACE_WITH_LIVE_VALUE
  MODE3D_MPI_SCHEDULER REPLACE_WITH_STATIC_DYNAMIC_OR_BLOCK_CYCLIC
  MODE3D_MPI_DYNAMIC_CHUNK REPLACE_WITH_LIVE_VALUE
  MODE3D_PARALLEL REPLACE_WITH_OPENMP_THREADS_OR_SERIAL
  MODE3D_THREADS REPLACE_WITH_LIVE_VALUE
