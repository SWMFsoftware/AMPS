! =============================================================================
! AMPS Earth validation C19A GRIDDED branch
! GOES-13/15 EPEAD east-west directional SEP-access validation
!
! This is a complete, runnable default input deck.  It represents GOES-13 at
! 2012-05-17 06:00 UTC and uses T05 on the standalone Mode3D mesh.  Before a
! manual run, place the user-supplied driver at:
!
!   srcEarth/test/C19/data/ts05_driver_may2012.txt
!
! and launch from srcEarth/test/C19 so the relative DRIVER_FILE and TRAJ_FILE
! paths below resolve.  run_C19.py copies this file into each run directory and
! changes named directives such as EPOCH, FIELD_MODEL, DRIVER_FILE, mesh
! controls, directional resolution, scheduler, and thread count.  No macro or
! placeholder substitution is required.
! =============================================================================

#RUN_INFO
RUN_ID                         C19_gridded_t05_goes13_20120517T060000Z

#CALCULATION_MODE
CALC_TARGET                    CUTOFF_RIGIDITY
FIELD_EVAL_METHOD              GRID_3D

#CUTOFF_RIGIDITY
! The 0.5-500 MeV bracket contains the nominal P4 (15-40 MeV) and P5
! (38-82 MeV) response ranges with substantial margin on both sides.
CUTOFF_EMIN                    0.5
CUTOFF_EMAX                    500.0
CUTOFF_MAX_PARTICLES           1
CUTOFF_NENERGY                 120
CUTOFF_SAMPLING                VERTICAL
CUTOFF_SEARCH_ALGORITHM        UPPER_SCAN
CUTOFF_UPPER_SCAN_N            120
CUTOFF_SCAN_SPACING            LINEAR
CUTOFF_TRACE_POLICY            ACCURATE
CUTOFF_BACKTRACE_CHARGE        REVERSED
CUTOFF_TRACE_LIMIT_POLICY      FORBIDDEN
CUTOFF_MAX_TRAJ_TIME           300.0
DIRECTIONAL_MAP                T
DIRMAP_LON_RES                 10.0
DIRMAP_LAT_RES                 10.0

#PARTICLE_SPECIES
SPECIES                        PROTON
CHARGE                         1
MASS_AMU                       1.007276466621

#BACKGROUND_FIELD
! The driver record at EPOCH overrides the parser-safe static values below.
FIELD_MODEL                    T05
EPOCH                          2012-05-17T06:00:00
DRIVER_FILE                    data/ts05_driver_may2012.txt
DST                            -50.0
PDYN                           4.0
IMF_BX                         0.0
IMF_BY                         0.0
IMF_BZ                         -5.0
SW_VX                          -450.0
SW_N                           5.0
G1                             0.0
G2                             0.0
G3                             0.0
T05_W1                         0.0
T05_W2                         0.0
T05_W3                         0.0
T05_W4                         0.0
T05_W5                         0.0
T05_W6                         0.0

#MODE3D_MESH
MODE3D_MESH_RES_EARTH_RE       0.05
MODE3D_MESH_RES_BOUNDARY_RE    2.0
MODE3D_MESH_COARSENING         LINEAR
MODE3D_MESH_EXPONENT           1.0

#DOMAIN_BOUNDARY
! Bare lengths are kilometers.  The domain extends to +/-40 Earth radii.
DOMAIN_X_MIN                  -254848.0
DOMAIN_X_MAX                   254848.0
DOMAIN_Y_MIN                  -254848.0
DOMAIN_Y_MAX                   254848.0
DOMAIN_Z_MIN                  -254848.0
DOMAIN_Z_MAX                   254848.0
R_INNER                        6371.2

#SPECTRUM
! Required by the common parser.  Directional response folding is performed by
! run_C19.py, which uses the same default gamma=3 unless overridden.
SPECTRUM_TYPE                  POWER_LAW
SPEC_J0                        1.0
SPEC_GAMMA                     3.0
SPEC_E0                        100.0
SPEC_EMIN                      0.5
SPEC_EMAX                      500.0

#OUTPUT_DOMAIN
! The committed trajectory file contains the default GOES-13 sample.  The
! runner creates a one-line file with the selected spacecraft position/epoch in
! each run directory and retains this same filename.
OUTPUT_MODE                    TRAJECTORY
TRAJ_FRAME                     GEO
TRAJ_FILE                      C19_trajectory.txt
FLUX_DT                        5.0

#OUTPUT_OPTIONS
OUTPUT_COORDS                  GEO

#NUMERICAL
DT_TRACE                       0.25
ADAPTIVE_DT                    T
MAX_STEPS                      500000
MAX_TRACE_TIME                 300.0
MAX_TRACE_DISTANCE             400.0
TRAP_DETECTION                 T
MODE3D_MPI_SCHEDULER           DYNAMIC
MODE3D_MPI_DYNAMIC_CHUNK       16
MODE3D_PARALLEL                THREADS
MODE3D_THREADS                 16

!#END
