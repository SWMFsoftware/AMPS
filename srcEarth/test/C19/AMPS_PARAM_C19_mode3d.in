! ============================================================================
! AMPS validation test C19A: GOES EPEAD east-west directional SEP access
! Standalone Mode3D template. run_C19.py renders one GEO trajectory sample/run.
! ============================================================================

#RUN_INFO
RUN_ID                         __RUN_ID__

#CALCULATION_MODE
CALC_TARGET                    CUTOFF_RIGIDITY
FIELD_EVAL_METHOD              GRID_3D

#CUTOFF_RIGIDITY
CUTOFF_EMIN                    __CUTOFF_EMIN_MEV__
CUTOFF_EMAX                    __CUTOFF_EMAX_MEV__
CUTOFF_MAX_PARTICLES           1
CUTOFF_NENERGY                 __CUTOFF_SCAN_N__
CUTOFF_SAMPLING                VERTICAL
CUTOFF_SEARCH_ALGORITHM        UPPER_SCAN
CUTOFF_UPPER_SCAN_N            __CUTOFF_SCAN_N__
CUTOFF_BACKTRACE_CHARGE        REVERSED
CUTOFF_TRACE_LIMIT_POLICY      FORBIDDEN
CUTOFF_MAX_TRAJ_TIME           __MAX_TRACE_TIME__
DIRECTIONAL_MAP                T
DIRMAP_LON_RES                 __DIRMAP_LON_RES__
DIRMAP_LAT_RES                 __DIRMAP_LAT_RES__

#PARTICLE_SPECIES
SPECIES                        PROTON
CHARGE                         1
MASS_AMU                       1.007276466621

#BACKGROUND_FIELD
FIELD_MODEL                    __FIELD_MODEL__
EPOCH                          __EPOCH__
DRIVER_FILE                    __DRIVER_FILE__

#DOMAIN_BOUNDARY
DOMAIN_X_MAX                   40.0
DOMAIN_X_MIN                  -40.0
DOMAIN_Y_MAX                   40.0
DOMAIN_Y_MIN                  -40.0
DOMAIN_Z_MAX                   40.0
DOMAIN_Z_MIN                  -40.0
R_INNER                        1.0

#MODE3D_MESH
MODE3D_MESH_RES_EARTH_RE       __MESH_RES_EARTH_RE__
MODE3D_MESH_RES_BOUNDARY_RE    __MESH_RES_BOUNDARY_RE__
MODE3D_MESH_COARSENING         __MESH_COARSENING__
MODE3D_MESH_EXPONENT           __MESH_EXPONENT__

#OUTPUT_DOMAIN
OUTPUT_MODE                    TRAJECTORY
TRAJ_FRAME                     GEO
TRAJ_FILE                      C19_trajectory.txt
FLUX_DT                        5.0

#NUMERICAL
DT_TRACE                       __DT_TRACE__
ADAPTIVE_DT                    T
MAX_TRACE_TIME                 __MAX_TRACE_TIME__
MAX_TRACE_DISTANCE             __MAX_TRACE_DISTANCE_RE__
MODE3D_MPI_SCHEDULER           __MPI_SCHEDULER__
MODE3D_MPI_DYNAMIC_CHUNK       __DYNAMIC_CHUNK__
MODE3D_PARALLEL                THREADS
MODE3D_THREADS                 __THREADS__

!#END
