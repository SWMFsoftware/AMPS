Compile=
>>>@echo "test_Mars-ions--valgrind_compile..." > test_Mars-ions--valgrind.diff
>>>@# The memcheck variant (utility/valgrind/README.md). The nightly runs it only on machines that declare the
>>>@# capability valgrind (utility/nightly: a Table name <test>--valgrind is shown as <test>(valgrind)); without
>>>@# valgrind the result file says so. Debug information through FLAGC_EXTRA=-g (gcc -g does not change the generated
>>>@# code; EXTRACOMPILEROPTIONS would replace the Config.pl -compiler-option values); -check_macro=off keeps the build/
>>>@# copies line-for-line equal to the sources (memcheck's file:line), and build/ is removed so that no object of an
>>>@# earlier build is reused.
>>>@if ! command -v valgrind > /dev/null 2>&1; then echo "valgrind is not installed on `hostname -s`: test_Mars-ions--valgrind needs it" >> test_Mars-ions--valgrind.diff; fi
>>>@command -v valgrind > /dev/null 2>&1 || exit 0; rm -rf $(WSD)
>>>@command -v valgrind > /dev/null 2>&1 || exit 0; ./Config.pl -check_macro=off
>>>@command -v valgrind > /dev/null 2>&1 || exit 0; ./Config.pl -application=test/Mars-ions -spice-path=nospice -spice-kernels=nospice -model-data-path=$(PTDIR)/data/input/Mars-ions -amps-test=on $(TESTMars-ions--valgrindKEYS)
>>>@command -v valgrind > /dev/null 2>&1 || exit 0; $(MAKE) -j$(TESTCOMPILEJOBS) amps FLAGC_EXTRA=-g
>>>@command -v valgrind > /dev/null 2>&1 || exit 0; ./Config.pl -check_macro=on
>>>@command -v valgrind > /dev/null 2>&1 || exit 0; echo "test_Mars-ions--valgrind_compile... done" >> test_Mars-ions--valgrind.diff

Rundir=
>>>@echo "test_Mars-ions--valgrind_rundir..." >> test_Mars-ions--valgrind.diff
>>>rm -rf   $(TESTMars-ions--valgrindDIR)
>>>mkdir -p $(TESTMars-ions--valgrindDIR)
>>>@if [ -f amps ]; then mv amps $(TESTMars-ions--valgrindDIR) && echo "test_Mars-ions--valgrind_rundir... done" >> test_Mars-ions--valgrind.diff; fi

Run=
>>>@echo "test_Mars-ions--valgrind_run..." >> test_Mars-ions--valgrind.diff
>>>@echo Test test_Mars-ions--valgrind has started: `date`
>>>@# a native run first writes the cell-measure cache amr.sig=*.CenterNodeMeasure.v*.bin, which the memcheck run
>>>@# then reads instead of computing the cut-cell volumes under valgrind
>>>command -v valgrind > /dev/null 2>&1 || exit 0; cd $(TESTMars-ions--valgrindDIR) && (mpirun -np 2 --bind-to none ./amps > native.log 2>&1; rm -rf PT)
>>>command -v valgrind > /dev/null 2>&1 || exit 0; cd $(TESTMars-ions--valgrindDIR) && $(PTDIR)/utility/valgrind/run_memcheck.sh -n 2 -t 2400 -o memcheck ./amps > memcheck.out 2>&1; echo $$? > memcheck.status
>>>@echo "test_Mars-ions--valgrind_run... done" >> test_Mars-ions--valgrind.diff

Check=
>>>@echo "test_Mars-ions--valgrind_check..." >> test_Mars-ions--valgrind.diff
>>>@# PASS (an empty result file) when memcheck reported no error and amps ended normally; otherwise the errors
>>>@# grouped by utility/valgrind/summarize_memcheck.py (full stacks: $(TESTMars-ions--valgrindDIR)/memcheck/memcheck.<rank>.log)
>>>@if ! command -v valgrind > /dev/null 2>&1; then echo "valgrind is not installed on `hostname -s`: test_Mars-ions--valgrind needs it" > test_Mars-ions--valgrind.diff; \
>>>elif [ "`cat $(TESTMars-ions--valgrindDIR)/memcheck.status 2>/dev/null`" = 0 ] && [ "`cat $(TESTMars-ions--valgrindDIR)/memcheck/exit_status 2>/dev/null`" = 0 ]; then : > test_Mars-ions--valgrind.diff; \
>>>else (echo "memcheck: `tail -1 $(TESTMars-ions--valgrindDIR)/memcheck/summary.txt 2>/dev/null`; amps exit status `cat $(TESTMars-ions--valgrindDIR)/memcheck/exit_status 2>/dev/null`"; \
>>>head -12 $(TESTMars-ions--valgrindDIR)/memcheck/summary.txt 2>/dev/null) > test_Mars-ions--valgrind.diff; fi
>>>@ls -l test_Mars-ions--valgrind.diff
>>>@echo Test test_Mars-ions--valgrind has finished: `date`
