Compile=
! GM/BATSRUS+IE/Ridley_serial+IM/RCM2+RB/RBE (SWMF test_swpc) + PT/AMPS in the SWMF installation SWMF of this
! tree: PT/AMPS is a copy of the tracked files of THIS tree (as for the sep-swmf tests in SWMF-IH), not the
! GitHub master that 'Config.pl -install' would clone, so the test checks the AMPS commit under test.
>>>@echo "test_Geospace-SWMF-AMPS_compile..." > test_Geospace-SWMF-AMPS$(TESTGeospace-SWMF-AMPS-REF).diff
<<<ifeq ($(wildcard SWMF/*),)
>>>@echo "Installing SWMF in SWMF (PT/AMPS is this AMPS tree) ..."
>>>git clone --depth 1 git@github.com:SWMFsoftware/SWMF
>>>ln -s ${PTDIR}/SWMF_data ${PTDIR}/SWMF/SWMF_data
>>>mkdir -p SWMF/PT/AMPS
>>>git ls-files -z | rsync -rlpc --from0 --files-from=- --ignore-missing-args ./ SWMF/PT/AMPS/
>>>ln -s ${PTDIR}/SWMF_data/PT/AMPS/data SWMF/PT/AMPS/data

<<<ifeq ($(COMPILE.c),icc)
>>>cd SWMF; ./Config.pl -sleep=10 -install -compiler=ifort,iccmpicxx
<<<endif

<<<ifeq ($(COMPILE.c),gcc)
>>>cd SWMF; ./Config.pl -sleep=10 -install -compiler=gfortran,gcc_mpicc
<<<endif

<<<ifeq ($(COMPILE.c),pgcc)
>>>cd SWMF; ./Config.pl -sleep=10 -install -compiler=pgf90,pgccmpicxx
<<<endif
<<<endif

! refresh PT/AMPS from this tree (files are copied only when their content differs)
>>>git ls-files -z | rsync -rlpc --from0 --files-from=- --ignore-missing-args ./ SWMF/PT/AMPS/
>>>ln -sfn ${PTDIR}/SWMF_data/PT/AMPS/data SWMF/PT/AMPS/data

! SWMF's SWPC test (GM/BATSRUS + IE + IM/RCM2 + RB/RBE) runs here in the compile stage and leaves the
! GM/IE/IM/RB restart (SWMF_RESTART.20140410_000200) in SWMF/run_test; keep a private copy of that directory,
! because the other SWMF tests share SWMF/ and nothing may touch it in the run stage
>>>@echo "Running SWMF test_swpc..." >> test_Geospace-SWMF-AMPS$(TESTGeospace-SWMF-AMPS-REF).diff
>>>cd SWMF; $(MAKE) -j$(TESTCOMPILEJOBS) test_swpc
>>>rm -rf SWMF/run_test.Geospace-SWMF-AMPS; cp -a SWMF/run_test SWMF/run_test.Geospace-SWMF-AMPS

>>>@echo "Installing AMPS as PT component..." >> test_Geospace-SWMF-AMPS$(TESTGeospace-SWMF-AMPS-REF).diff
>>>cd SWMF; ./Config.pl -v=PT/AMPS
>>>cd SWMF; ./Config.pl -o=PT:spice-path=nospice,spice-kernels=nospice,application=test/geospace/swmf/geospace,amps-test=on

>>>@echo "Compiling SWMF with AMPS..." >> test_Geospace-SWMF-AMPS$(TESTGeospace-SWMF-AMPS-REF).diff
>>>cd SWMF; rm -f bin/SWMF.exe.Geospace-SWMF-AMPS; $(MAKE) -j$(TESTCOMPILEJOBS) && cp bin/SWMF.exe bin/SWMF.exe.Geospace-SWMF-AMPS

>>>@echo "test_Geospace-SWMF-AMPS_compile... done" >> test_Geospace-SWMF-AMPS$(TESTGeospace-SWMF-AMPS-REF).diff


Rundir=
! the test's own run directory: the test_swpc restart state plus its own SWMF.exe (run_test links SWMF.exe to
! SWMF/bin/SWMF.exe: remove the link first, a cp through it would overwrite SWMF/bin/SWMF.exe) and the PT
! directories of 'make rundir' (run_test was made while PT was Empty)
>>>@echo "test_Geospace-SWMF-AMPS_rundir..." >> test_Geospace-SWMF-AMPS$(TESTGeospace-SWMF-AMPS-REF).diff
>>>rm -rf $(TESTGeospace-SWMF-AMPSDIR); cp -a SWMF/run_test.Geospace-SWMF-AMPS $(TESTGeospace-SWMF-AMPSDIR)
>>>rm -f $(TESTGeospace-SWMF-AMPSDIR)/SWMF.exe; cp SWMF/bin/SWMF.exe.Geospace-SWMF-AMPS $(TESTGeospace-SWMF-AMPSDIR)/SWMF.exe
>>>rm -rf $(TESTGeospace-SWMF-AMPSDIR)/PT; mkdir -p $(TESTGeospace-SWMF-AMPSDIR)/PT/plots $(TESTGeospace-SWMF-AMPSDIR)/PT/restartIN $(TESTGeospace-SWMF-AMPSDIR)/PT/restartOUT
>>>cp input/test/geospace/swmf/* $(TESTGeospace-SWMF-AMPSDIR)
>>>@echo "test_Geospace-SWMF-AMPS_rundir... done" >> test_Geospace-SWMF-AMPS$(TESTGeospace-SWMF-AMPS-REF).diff


Run=
>>>@echo "test_Geospace-SWMF-AMPS_run..." >> test_Geospace-SWMF-AMPS$(TESTGeospace-SWMF-AMPS-REF).diff
>>>@echo Test test_Geospace-SWMF-AMPS has started: `date`

>>>cd $(TESTGeospace-SWMF-AMPSDIR); OMP_NUM_THREADS=1 ${MPIRUN} ./SWMF.exe > runlog 2>&1 || (tail -n 60 runlog; exit 1)

>>>@echo "test_Geospace-SWMF-AMPS_run... done" >> test_Geospace-SWMF-AMPS$(TESTGeospace-SWMF-AMPS-REF).diff
>>>@echo Test test_Geospace-SWMF-AMPS has finished: `date`


Check=
>>>@echo "test_Geospace-SWMF-AMPS_check..." >> test_Geospace-SWMF-AMPS$(TESTGeospace-SWMF-AMPS-REF).diff

>>>-@utility/ReduceFile.pl $(TESTGeospace-SWMF-AMPSDIR)/PT/plots/amps.TrajectoryTracking.out=1.s=0.H_PLUS1.dat 1000
>>>-@utility/ReduceFile.pl $(TESTGeospace-SWMF-AMPSDIR)/PT/plots/pic.H_PLUS1.s=0.out=1.dat 1000

>>>@echo "--- Trajectory subtest ---" >> test_Geospace-SWMF-AMPS$(TESTGeospace-SWMF-AMPS-REF).diff

>>>-@${SCRIPTDIR}/DiffNum.pl \
>>>  $(TESTGeospace-SWMF-AMPSDIR)/PT/plots/amps.TrajectoryTracking.out=1.s=0.H_PLUS1.dat.Reduced.Step=1000 \
>>>  output/test_Geospace-SWMF-AMPS/amps.TrajectoryTracking.out=1.s=0.H_PLUS1.dat.Reduced.Step=1000 \
>>>  > test_Geospace-SWMF-AMPS--trajectory$(TESTGeospace-SWMF-AMPS-REF).diff

>>>@echo "--- Volume subtest ---" >> test_Geospace-SWMF-AMPS$(TESTGeospace-SWMF-AMPS-REF).diff

>>>-@${SCRIPTDIR}/DiffNum.pl \
>>>  $(TESTGeospace-SWMF-AMPSDIR)/PT/plots/pic.H_PLUS1.s=0.out=1.dat.Reduced.Step=1000 \
>>>  output/test_Geospace-SWMF-AMPS/pic.H_PLUS1.s=0.out=1.dat.Reduced.Step=1000 \
>>>  > test_Geospace-SWMF-AMPS--volume$(TESTGeospace-SWMF-AMPS-REF).diff

>>>@cat test_Geospace-SWMF-AMPS--trajectory$(TESTGeospace-SWMF-AMPS-REF).diff \
>>>    test_Geospace-SWMF-AMPS--volume$(TESTGeospace-SWMF-AMPS-REF).diff \
>>>    > test_Geospace-SWMF-AMPS$(TESTGeospace-SWMF-AMPS-REF).diff

>>>@ls -l test_Geospace-SWMF-AMPS--trajectory$(TESTGeospace-SWMF-AMPS-REF).diff
>>>@ls -l test_Geospace-SWMF-AMPS--volume$(TESTGeospace-SWMF-AMPS-REF).diff
>>>@ls -l test_Geospace-SWMF-AMPS$(TESTGeospace-SWMF-AMPS-REF).diff
>>>@echo Test test_Geospace-SWMF-AMPS verification completed: `date`

<#
