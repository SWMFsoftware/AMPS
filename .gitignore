# This is a source-controlled build driver, not a generated build tree.
!srcMoon/test/build_m2_qualification.py
# Retained-binary identity checks are maintained test source, too.
!srcMoon/test/test_m2_build_identity.py
# M3's isolated builder and bounded protocol controls are maintained source.
# Admit only this documented suite; generated build products remain ignored.
!srcMoon/test/build_m3_source_qualification.py
!srcMoon/test/test_m3_source_build_protocol.py
!srcMoon/test/source_qualification_build/
!srcMoon/test/source_qualification_build/CONTRACT.md
!srcMoon/test/source_qualification_build/README.md
!srcMoon/test/source_qualification_build/test_protocol.py
# The manual invokes this maintained source file. Without this exception the
# broad *build* rule silently omits it from fresh checkouts and breaks make PDF.
!doc/build_manual.py
# Local TeX engines/caches and compilation products are reproducible artifacts,
# not manual sources. Keep them out of commits when building the PDF locally.
/doc/.build-tools/
/doc/.tex-cache/
/doc/.tex-config/
/doc/.plot-cache/
/doc/build-manual/
/doc/AMPS.pdf.partial
*Assembled*

# Maintained chemical-database tools and Moon build adapter are source files.
# Keep generated build trees ignored while making required helpers committable.
!srcMoon/test/chemical_database_build.py
!utility/chemical_database/build_database.py
!utility/chemical_database/python/amps_chemical_database/build.py
