! Memory-budget candidate for a 200 GB (decimal) host allocation budget.
! Derived from m1_sphere.in: only volume cell-size targets and output paths
! differ. No source, epoch, observation grid, domain extent, or physics changes.
! The factor-six coarsening is an operational choice, NOT convergence evidence.
! Approved 2026-10-14 for I11's 480/240/120/60 km sequence. I12 tests wiring;
! only actual convergence and a reviewed I13 baseline can establish M1.
#begin application: moon
spice_path = /home/vtenishe/SPICE
surface_geometry = sphere
surface_mesh_resolution_m = 100000

! Preserve domain extents but coarsen ALL volume targets, including the
! far-field and angular/polar targets; changing only the surface target would
! leave the expensive extended fine-volume mesh in place.
mesh_profile = custom
mesh_near_surface_cell_size_m = 60000
mesh_near_surface_extent_m = 200000
! Fixed across 480/240/120/60 km: AMPS requires far >= near at every level.
mesh_far_field_cell_size_m = 480000
mesh_far_field_extent_m = 10000000
mesh_outer_cell_size_m = 104226000
! Full-volume Tecplot output is not needed by I11-I13 and can be hundreds of
! gigabytes at this resolution. Set true only for a deliberately provisioned
! visualization run; the internal MPI AMR-tree file remains enabled.
mesh_output_tecplot = false
mesh_angular_resolution_m_by_sza = 0:60000,30:60000,60:30000,90:30000,120:60000,180:60000
mesh_terminator_half_width_deg = 15
mesh_polar_cap_start_latitude_deg = 75
mesh_polar_resolution_m = 30000

lola_product_id = LDEM_4
lola_image_file = /data/vtenishe/moon_validation_data/lola/raw/LDEM_4.IMG
lola_label_file = /data/vtenishe/moon_validation_data/lola/raw/LDEM_4.LBL
surface_cea_file = ../../test_output/srcMoon/memory200/sphere-unused.cea
surface_tecplot_file = ../../test_output/srcMoon/memory200/sphere-unused.dat
m2_environment = disabled

simulation_start_utc = 2009-01-24T00:00:00
simulation_environment_mode = frozen
random_seed = 731993
profile_altitude_near_maximum_m = 200000
profile_altitude_near_step_m = 5000
profile_altitude_middle_maximum_m = 1000000
profile_altitude_middle_step_m = 25000
profile_altitude_far_maximum_m = 10000000
profile_altitude_far_points_per_decade = 8
profile_solar_zenith_angles_deg = 0,30,60,90,120,180
profile_include_body_fixed_poles = true
profile_include_shell_average = true
profile_shell_angular_weighting = solid-angle

limb_observer = earth
limb_plane = sun-moon-earth
limb_sides = both
limb_branch_reference = projected-sun
limb_tangent_maximum_altitude_m = 1000000
tail_center_direction = anti-lunar
tail_map_coordinate_system = j2000-ra-dec
tail_map_display_orientation = west-right
tail_map_half_width_deg = 7.5
tail_beam_diameter_deg = 1.0
tail_exposure_duration_s = 120
tail_beam_response = unresolved
tail_temporal_operator = exposure-average
#end application
